# Server
PORT=3001
BASE_URL=http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/beatific-admin

# JWT
JWT_SECRET=your-jwt-secret-here

# Cloudinary (optional - if not set, files are stored locally in uploads/)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# PDF Decomposer Service (optional)
PDF_DECOMPOSER_URL=http://localhost:5050
