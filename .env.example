# Server
PORT=3001
BASE_URL=http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/beatific-admin

# JWT
JWT_SECRET=your-jwt-secret-here

# Cloudinary (optional - if not set, files are stored locally in uploads/)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# PDF Decomposer Service (optional)
PDF_DECOMPOSER_URL=http://localhost:5050

# Max image upload size in MB (default 200 — matches PDF upload limit if not set)
IMAGE_MAX_SIZE_MB=200

# Max PDF upload size in MB (default 200 — enough for 1000-page PDFs)
PDF_MAX_SIZE_MB=200

# Per-request timeout in ms for legacy synchronous PDF import (default 300000 = 5 min)
PDF_REQUEST_TIMEOUT_MS=300000

# Health-check cache TTL in ms (default 30000 = 30 s)
PDF_HEALTH_TTL_MS=30000

# Background job timeout for Python decompose call (default 1800000 = 30 min)
# This is generous because background jobs are not blocking the HTTP response.
PDF_BACKGROUND_TIMEOUT_MS=1800000

# Max time to keep completed/failed jobs in memory (default 1800000 = 30 min)
PDF_JOB_TTL_MS=1800000

# Express JSON body limit (default 100mb — needed for 500+ page PDF saves)
EXPRESS_JSON_LIMIT=100mb

# Server-level timeout in ms (default 300000 = 5 min)
SERVER_TIMEOUT_MS=300000
